{
  "name": "crshhx",
  "productName": "Crshhx Crosshair Studio",
  "version": "1.2.0",
  "description": "Zero-latency, pro-grade gaming crosshair overlay for Valorant, CS2, Fortnite",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:main": "tsc -p tsconfig.node.json -w",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -p \"[{name}]\" -n \"Vite,Main,App\" -c \"cyan,blue,magenta\" \"vite\" \"tsc -p tsconfig.node.json -w\" \"electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:main": "tsc -p tsconfig.node.json --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "author": {
    "name": "sfingW",
    "url": "https://github.com/sfingW/crshhX"
  },
  "homepage": "https://github.com/sfingW/crshhX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfingW/crshhX.git"
  },
  "license": "UNLICENSED"
}
